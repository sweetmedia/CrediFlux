# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ENVIRONMENT=development

# Database
# Opción preferida: DATABASE_URL (tiene prioridad si también hay DB_*).
DATABASE_URL=postgres://crediflux_user:crediflux_pass@db:5432/crediflux_db
# Alternativa: variables sueltas (DB_PASSWORD no tiene default; producción falla si falta).
# DB_NAME=crediflux_db
# DB_USER=crediflux_user
# DB_PASSWORD=change-me
# DB_HOST=db
# DB_PORT=5432

# Número de proxies inversos de confianza delante de Django (X-Forwarded-For para throttling)
DRF_NUM_PROXIES=1

# Contraseña del superusuario que crea setup_initial_tenant.py
# (si se omite se genera una aleatoria y se imprime una sola vez)
# INITIAL_SUPERUSER_PASSWORD=

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Email Configuration
# For development with MailHog (docker): localhost:1025
# For production: smtp.gmail.com:587
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@crediflux.local

# Storage (S3 for production)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Sentry (for production monitoring)
SENTRY_DSN=

# Application Settings
DEFAULT_CURRENCY=USD
COMPANY_NAME=CrediFlux
