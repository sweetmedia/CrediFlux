# CrediFlux — variables de producción (docker-compose.prod.yml).
# Copiar a .env.production en el servidor (chmod 600, nunca al repo) y rellenar todo lo marcado.

# --- Postgres (contenedor db; en Sevalla se reemplaza por DATABASE_URL del Postgres gestionado) ---
POSTGRES_DB=crediflux
POSTGRES_USER=crediflux
# openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=CAMBIAR

# --- Django ---
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CAMBIAR
# Fernet; obligatoria en producción. Guardarla aparte: sin ella no se descifran los secretos de BD.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=CAMBIAR
DJANGO_ALLOWED_HOSTS=.crediflux.com.do
TENANT_BASE_DOMAIN=crediflux.com.do
COOKIE_DOMAIN=.crediflux.com.do
CORS_ALLOWED_ORIGINS=https://app.crediflux.com.do
# Host del tenant público (el healthcheck lo usa; debe existir como Domain del tenant public).
PUBLIC_HOST=app.crediflux.com.do
FRONTEND_URL=https://app.crediflux.com.do
BACKEND_URL=https://app.crediflux.com.do

# Un solo proxy de confianza: nginx del host reescribe X-Forwarded-For con la IP real del
# cliente (CF-Connecting-IP de Cloudflare). Ver docs/deployment/nginx/crediflux-prod.conf.
DRF_NUM_PROXIES=1

# --- Correo (SMTP de Resend; dominio verificado con SPF/DKIM) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
# API key de Resend
EMAIL_HOST_PASSWORD=CAMBIAR
DEFAULT_FROM_EMAIL=CrediFlux <no-reply@crediflux.com.do>

# --- Archivos ---
# Media en ./data/media del host (con backup). S3 queda desactivado hasta separar media de static.
USE_S3=False

# --- Sentry (opcional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_SEND_PII=False

# --- IA (opcional) ---
AI_ENABLED=False

# --- Recursos (VPS compartido de 4 GB) ---
GUNICORN_WORKERS=3
CELERY_CONCURRENCY=2
BACKEND_PORT=8700
FRONTEND_PORT=3700

# --- Build del frontend (se incrustan en el bundle) ---
VITE_API_URL=https://app.crediflux.com.do
VITE_APP_URL=https://app.crediflux.com.do
# Dominio de las financieras para /select-tenant (igual que TENANT_BASE_DOMAIN).
VITE_TENANT_BASE_DOMAIN=crediflux.com.do
